<view class="container"><view class="header"><view class="title">绿色快递驿站</view><view>让每一次取件都更环保</view></view><block wx:if="{{!logged}}"><view class="card empty">请先登录<button bindtap="goLogin">登录</button></view></block><block wx:else><view class="card"><view class="section-title">我的快递</view><block wx:if="{{packages.length}}"><block wx:for="{{packages}}" wx:key="id"><view class="row"><view><view>{{item.company}} · {{item.trackingNo}}</view><view class="muted">货架：{{item.shelfCode}}　{{item.status==='STORED'?'待取件':'已取件'}}</view></view><button wx:if="{{item.status==='STORED'}}" size="mini" data-id="{{item.id}}" bindtap="pickup">取件</button></view></block></block><view wx:else class="empty">暂无快递</view></view><view class="card"><view class="section-title">驿站公告</view><block wx:for="{{notices}}" wx:key="id"><view class="row"><view>{{item.title}}</view><view class="muted">{{item.content}}</view></view></block></view></block></view>
